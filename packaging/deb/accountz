#!/usr/bin/env bash
# Open Accountz in an app window (the server runs as the "accountz" service).
URL="http://localhost:3001"

if ! curl -sf -o /dev/null --connect-timeout 1 "$URL"; then
  # Service may still be starting (e.g. right after boot) - wait up to 30s
  for _ in $(seq 30); do
    sleep 1
    curl -sf -o /dev/null --connect-timeout 1 "$URL" && break
  done
fi

if ! curl -sf -o /dev/null --connect-timeout 1 "$URL"; then
  msg="Accountz is not running. Try: sudo systemctl restart accountz"
  command -v notify-send >/dev/null && notify-send "Accountz" "$msg"
  echo "$msg" >&2
  exit 1
fi

for b in brave-browser brave google-chrome chromium-browser chromium microsoft-edge; do
  if command -v "$b" >/dev/null 2>&1; then
    exec "$b" --app="$URL" >/dev/null 2>&1
  fi
done
exec xdg-open "$URL"
