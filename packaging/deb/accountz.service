[Unit]
Description=Accountz personal finance tracker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=accountz
Group=accountz
WorkingDirectory=/opt/accountz
StateDirectory=accountz
EnvironmentFile=/etc/accountz/accountz.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/accountz/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
